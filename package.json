{
  "name": "album-review-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "vite",
    "add-album": "tsx scripts/add-album.ts",
    "cache-covers": "tsx scripts/cache-cover-art.ts",
    "build": "tsx scripts/build.ts",
    "serve": "vite",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "vitest run --coverage",
    "test:coverage": "tsx scripts/test-coverage.ts",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "fallow": "fallow",
    "validate": "npm run typecheck && npm run lint:md && npm run fallow",
    "validate:ci": "npm run typecheck && npm run lint:md && fallow audit"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^5.4.3"
    },
    "katex": "^0.19.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "daisyui": "^5.7.50",
    "fallow": "^3.34.1",
    "jsdom": "30.1.3",
    "markdownlint-cli2": "^0.23.0",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.0"
  }
}
