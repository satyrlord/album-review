{
  "name": "album-review-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "add-album": "tsx scripts/add-album.ts",
    "cache-covers": "tsx scripts/cache-cover-art.ts",
    "build": "tsx scripts/build.ts",
    "serve": "vite",
    "preview": "vite preview",
    "test": "playwright test",
    "test:coverage": "tsx scripts/test-coverage.ts",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "validate": "npm run typecheck && npm run lint:md"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.2",
    "daisyui": "^5.5.19",
    "markdownlint-cli2": "^0.22.0",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-istanbul": "^8.0.0"
  }
}
